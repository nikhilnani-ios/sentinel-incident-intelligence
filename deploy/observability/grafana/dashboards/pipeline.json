{
  "title": "Sentinel \u2014 Pipeline Health",
  "uid": "sentinel-pipeline",
  "tags": [
    "sentinel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "Signals accepted / sec",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(sentinel_ingest_accepted_total[5m])) by (type)",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "Throughput by signal type. A flat line at zero is the alert that matters."
    },
    {
      "title": "Ingest outcome mix",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(sentinel_ingest_accepted_total[5m]))",
          "legendFormat": "accepted",
          "refId": "A"
        },
        {
          "expr": "sum(rate(sentinel_ingest_duplicate_total[5m]))",
          "legendFormat": "duplicate",
          "refId": "B"
        },
        {
          "expr": "sum(rate(sentinel_ingest_rejected_total[5m]))",
          "legendFormat": "rejected",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "A rising duplicate rate usually means a monitoring system is retrying, not that anything is wrong."
    },
    {
      "title": "Correlation outcomes / sec",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(sentinel_correlation_processed_seconds_count[5m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "CREATED vs ATTACHED vs DEDUPLICATED. If ATTACHED collapses, the graph or the threshold has drifted."
    },
    {
      "title": "Correlation latency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(sentinel_correlation_processed_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(sentinel_correlation_processed_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "title": "Consumer lag",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(kafka_consumer_fetch_manager_records_lag_max) by (client_id)",
          "legendFormat": "{{client_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "description": "The single best indicator of whether the platform is keeping up."
    },
    {
      "title": "Dead letters (15m)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(increase(sentinel_kafka_dlq_total[15m]))",
          "legendFormat": "dlq",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Open SSE connections",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(sentinel_stream_connections)",
          "legendFormat": "connections",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Analysis generation latency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sentinel_insight_generation_seconds_bucket[10m])) by (le, kind))",
          "legendFormat": "{{kind}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "title": "Analysis cache hit rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(sentinel_insight_cache_total{result=\"hit\"}[15m])) / clamp_min(sum(rate(sentinel_insight_cache_total[15m])), 0.0001)",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Every hit is a model call not paid for. Content hashing is what makes this number high."
    }
  ]
}
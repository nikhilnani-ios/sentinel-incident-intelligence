# Public portfolio default. This never calls an external model and cannot incur model charges.
INSIGHT_MODE=demo
ANTHROPIC_API_KEY=
# Pinned for repeatable incident analysis. Override deliberately when upgrading models.
INSIGHT_MODEL=claude-sonnet-4-20250514

# Overridden in docker-compose; listed here for running services directly on the host.
DATABASE_URL=jdbc:postgresql://localhost:5432/sentinel
DATABASE_USER=sentinel
DATABASE_PASSWORD=sentinel
REDIS_URL=redis://localhost:6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
JWT_SECRET=local-development-secret-at-least-32-bytes
